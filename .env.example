# 应用配置模板：复制为 .env 后按需修改（.env 已加入 .gitignore，禁止提交真实密钥）
APP_NAME=ClipShare
ENVIRONMENT=development
LOG_LEVEL=INFO
# 本机直连数据库时使用；docker compose 环境内由 compose 文件自动注入
DATABASE_URL=postgresql+psycopg://clipshare:clipshare@localhost:5432/clipshare
# M3 新增：分享网页公网地址（与 /s/{code} 拼接形成分享链接，部署时覆盖为真实域名）
PUBLIC_BASE_URL=http://localhost:8000
# M3 新增：单条分享内容长度上限（字符数）
SHARE_MAX_CONTENT_LENGTH=100000
# M3 新增：速率限制（slowapi 语法：次数/单位，如 30/minute）
RATE_LIMIT_CREATE=30/minute
RATE_LIMIT_READ=60/minute

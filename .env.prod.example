# ============ ClipShare 生产环境变量模板 ============
#
# 用法：在目标服务器上执行
#   cp .env.prod.example .env && vim .env
# docker compose 会自动读取项目目录的 .env 用于变量插值；
# docker-compose.prod.yml 中带 ${VAR:?} 的变量缺失时，compose 直接报错拒绝启动。
# .env 已被 .gitignore 排除（.env.* 全忽略，仅放行模板），禁止提交、禁止发群。
#
# 安全提醒：本模板里的密码均为占位符，上线前必须生成随机强密码，禁止沿用开发环境
# 的 clipshare:clipshare 弱口令！建议命令：openssl rand -hex 32
# （纯十六进制字符，无 URL 特殊字符，可直接嵌入 DATABASE_URL，省去 URL 编码坑）

# ---- 数据库 ----
# PostgreSQL 超级用户/库名（db 服务按此建库，默认 clipshare 即可）
POSTGRES_USER=clipshare
# 数据库密码：openssl rand -hex 32 生成，务必替换
POSTGRES_PASSWORD=请替换为随机强密码（openssl rand -hex 32）
POSTGRES_DB=clipshare

# 应用数据库连接串（app 服务使用，指向本编排的 db 服务，端口 5432）
# 注意：内嵌的密码必须与上方 POSTGRES_PASSWORD 完全一致（改密码时两处同步改！）
DATABASE_URL=postgresql+psycopg://clipshare:请替换为随机强密码（与 POSTGRES_PASSWORD 一致）@db:5432/clipshare

# ---- 应用 ----
# 分享链接前缀：与 /s/{短码} 拼接成分享链接。
# 有域名（推荐）：https://你的域名     无域名：http://服务器公网IP
PUBLIC_BASE_URL=https://paste.example.com
# 应用名（页面标题/OpenAPI 标题）
APP_NAME=ClipShare
# 日志级别；production 环境 structlog 输出 JSON（便于日志平台采集）
LOG_LEVEL=INFO
# 单条分享内容长度上限（字符数，默认 100000）
SHARE_MAX_CONTENT_LENGTH=100000
# 速率限制（slowapi 语法，按 IP 内存瞬时计数）：创建 30/分钟、读取 60/分钟
RATE_LIMIT_CREATE=30/minute
RATE_LIMIT_READ=60/minute

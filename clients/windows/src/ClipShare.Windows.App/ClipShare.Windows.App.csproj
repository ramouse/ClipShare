<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>ClipShare.Windows.App</RootNamespace>
    <AssemblyName>ClipShare.Windows.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ClipShare.Windows.Application/ClipShare.Windows.Application.csproj" />
    <ProjectReference Include="../ClipShare.Windows.Infrastructure/ClipShare.Windows.Infrastructure.csproj" />
    <ProjectReference Include="../ClipShare.Windows.Platform/ClipShare.Windows.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../../app/static/icons/icon-192.png" Link="Assets/Square150x150Logo.png" />
    <Content Include="../../../../app/static/icons/icon-192.png" Link="Assets/Square44x44Logo.png" />
    <Content Include="../../../../app/static/icons/icon-512.png" Link="Assets/StoreLogo.png" />
  </ItemGroup>
</Project>

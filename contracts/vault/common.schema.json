{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipshare.local/contracts/vault/common.schema.json",
  "title": "ClipShare Vault v1 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInt64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "nonNegativeInt64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "syncPolicy": {
      "type": ["string", "null"],
      "enum": [null, "LOCAL_ONLY", "SELECTED_DEVICES", "ALL_PAIRED_DEVICES"]
    },
    "contentType": {
      "type": "string",
      "enum": ["TEXT", "URL", "FILE"]
    },
    "initializationState": {
      "type": "string",
      "enum": ["STAGED", "READY"]
    }
  }
}

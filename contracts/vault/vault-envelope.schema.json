{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipshare.local/contracts/vault/vault-envelope.schema.json",
  "title": "ClipShare Vault v1 encrypted envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "algorithm", "purpose", "vaultId", "originDeviceId",
    "entityId", "field", "keyEpoch", "nonceCounter", "nonce",
    "paddedPlaintextBytes", "cipherAndTag"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "A256GCM" },
    "purpose": {
      "enum": [
        "folder-metadata", "item-metadata", "item-payload", "file-key-wrap",
        "file-manifest", "file-chunk", "event-body", "epoch-wrapper"
      ]
    },
    "vaultId": { "$ref": "common.schema.json#/$defs/uuid" },
    "originDeviceId": { "$ref": "common.schema.json#/$defs/uuid" },
    "entityId": { "$ref": "common.schema.json#/$defs/uuid" },
    "field": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "keyEpoch": { "$ref": "common.schema.json#/$defs/positiveInt64" },
    "nonceCounter": { "$ref": "common.schema.json#/$defs/nonNegativeInt64" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$" },
    "paddedPlaintextBytes": { "$ref": "common.schema.json#/$defs/nonNegativeInt64" },
    "cipherAndTag": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,}$" }
  }
}

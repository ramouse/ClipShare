FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

COPY --chown=node:node package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci --ignore-scripts

COPY --chown=node:node app/static ./app/static
COPY --chown=node:node contracts ./contracts
COPY --chown=node:node scripts/generate-vault-c2-vectors.mjs ./scripts/generate-vault-c2-vectors.mjs
COPY --chown=node:node tests/e2e ./tests/e2e
COPY --chown=node:node test_harness/sandbox_guard.js ./test_harness/sandbox_guard.js

ARG SANDBOX_RUN_ID
RUN test -n "${SANDBOX_RUN_ID}"
LABEL com.clipshare.sandbox.run-id="${SANDBOX_RUN_ID}"

USER 1000:1000

CMD ["npm", "run", "e2e"]
